#!/bin/bash

trap cleanup SIGINT SIGTERM

# includes
source ./settings
source ./functions/topology.sh
source ./functions/testing.sh
source ./functions/stressor.sh
source ./functions/general.sh
source ./functions/errors.sh
source ./functions/tests/load_test.sh
source ./functions/tests/cores/rapid.sh
source ./functions/tests/cores/single_core.sh
source ./functions/tests/cores/random.sh
source ./functions/tests/allcore.sh
source ./functions/tests/browser.sh

# setup
initial_output

# clear ram cache
echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1

# calculate cores
num_cores=$(nproc)
num_cores=${num_cores:-1}
PHYSICAL_CORES=$((num_cores / 2))

# Get run vars
loops=${loops:-1}
rapid_tests=${rapid_tests:-0}
start_core=${start_core:-0}
rest_time=${rest_time:-1}
update_progress "Startup" $loop_counter $loops 

# main loop
START_TIME=$SECONDS
for ((loop_counter=1; loop_counter<=loops; loop_counter++)); do
    ELAPSED=$((SECONDS - START_TIME))
    ELAPSED_FORMATTED=$(printf "%02d:%02d:%02d" $((ELAPSED/3600)) $(((ELAPSED/60)%60)) $((ELAPSED%60)))
    HIGHEST_CLOCK="$(<"$current_dir/logs/clock.log") Ghz"
    END_CORE=$((PHYSICAL_CORES - 2))

    # Starting of the loop
    if [[ "$loop_counter" -gt 1 ]]; then
        echo "$(tput setaf 5)Running loop $loop_counter of $loops ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
        echo "$(tput setaf 8)[DEBUG] Highest CPU Clock: $HIGHEST_CLOCK" | tee -a "$output_log_file"
    else
        echo "$(tput setaf 5)Starting loop $loop_counter of $loops $(tput sgr0)" | tee -a "$output_log_file"
    fi

    # ------ High Load tests ------
    All core test
    update_progress "All Core" $loop_counter $loops 
    allCoreTest
    check_errors
    rest

    # ------ Low Load tests ------
    # Rapid tests
    for ((rapid_counter=1; rapid_counter<=rapid_tests; rapid_counter++)); do
        echo "$(tput setaf 4)Running rapid test loop "$rapid_counter"/"$rapid_tests"$(tput sgr0)" | tee -a "$output_log_file"
        update_progress "Rapid Tests" $loop_counter $loops 
        rapidTest
        check_errors
        rest
    done
    # Random core tests
    for ((random_counter=1; random_counter<=random_tests; random_counter++)); do
        echo "$(tput setaf 4)Running random test loop "$random_counter"/"$random_tests"$(tput sgr0)" | tee -a "$output_log_file"
        update_progress "Random Tests" $loop_counter $loops 
        randomStress
        check_errors
        rest
    done

    # ------ Signle Core tests ------
    for ((core=start_core; core<=END_CORE; core++)); do
        ELAPSED=$((SECONDS - START_TIME))
        ELAPSED_FORMATTED=$(printf "%02d:%02d:%02d" $((ELAPSED/3600)) $(((ELAPSED/60)%60)) $((ELAPSED%60)))
        core_second=$((core + PHYSICAL_CORES))
        core_next=$((core + 1))
        core_last=$((core_second + 1))

        if [[ ",$cpu_topology," == *"0"* ]]; then
            echo "$(tput setaf 3)Starting tests for cores $core + ($core_next + $core_second + $core_last) ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
        fi
        if [[ ",$cpu_topology," == *"1"* ]]; then
            echo "$(tput setaf 3)Starting tests for cores $core + $core_second ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
        fi
        if [[ ",$cpu_topology," == *"2"* ]]; then
            echo "$(tput setaf 3)Starting tests for cores $core + $core_next ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
        fi

        rest
        runTests "$core"

        ELAPSED=$((SECONDS - START_TIME))
        ELAPSED_FORMATTED=$(printf "%02d:%02d:%02d" $((ELAPSED/3600)) $(((ELAPSED/60)%60)) $((ELAPSED%60)))
        HIGHEST_CLOCK="$(<"$current_dir/logs/clock.log") Ghz"

        if [[ ",$cpu_topology," == *"0"* ]]; then
            echo "$(tput setaf 3)Finished tests for cores $core + ($core_next + $core_second + $core_last) ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
        fi
        if [[ ",$cpu_topology," == *"1"* ]]; then
            echo "$(tput setaf 3)Finished tests for cores $core + $core_second ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
        fi
        if [[ ",$cpu_topology," == *"2"* ]]; then
            echo "$(tput setaf 3)Finished tests for cores $core + $core_next ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
        fi
        
        echo "$(tput setaf 8)[DEBUG] Highest CPU Clock: $HIGHEST_CLOCK" | tee -a "$output_log_file"
        check_errors
        rest
    done

    FINISHED_LOOPS=$loop_counter
done

# fin
HIGHEST_CLOCK="$(<"$current_dir/logs/clock.log") Ghz"
ELAPSED=$((SECONDS - START_TIME))
ELAPSED_FORMATTED=$(printf "%02d:%02d:%02d" $((ELAPSED/3600)) $(((ELAPSED/60)%60)) $((ELAPSED%60)))

echo "$(tput setaf 3)Loops $FINISHED_LOOPS/$loops completed! ($ELAPSED_FORMATTED)$(tput sgr0)" | tee -a "$output_log_file"
echo "$(tput setaf 8)[DEBUG] Highest CPU Clock: $HIGHEST_CLOCK" | tee -a "$output_log_file"

cleanup